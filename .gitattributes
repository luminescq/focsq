# Дистрибутивные shell-скрипты (linux/focsq.sh, tools/*): CRLF ломает их
# shebang (`#!/bin/bash\r` не найден), а .gitattributes c eol=lf держит
# рабочую копию LF даже при core.autocrlf=true на Windows-машинах.
*.sh text eol=lf
*.desktop text eol=lf
